{
  "ollama": {
    "url": "http://localhost:11434/api/chat",
    "model": "qwen3:8b"
  },
  "memory": {
    "database": "memory.db",
    "max_search_results": 10
  },
  "assistant": {
    "name": "MyAI v2",
    "engine": "Ollama",
    "gpu": "NVIDIA RTX 3060 12 GB",
    "memory_label": "SQLite",
    "future_target": "Raspberry Pi 5 B"
  },
  "conversation": {
    "max_turns": 6
  },
  "hardware_watch": {
    "enabled": true,
    "interval_seconds": 10
  },
  "trusted_terminals": {
    "enabled": false,
    "connect_rssi": -60,
    "disconnect_rssi": -75,
    "terminals": []
  },
  "vision": {
    "enabled": false,
    "url": "http://localhost:11434/api/chat",
    "model": "",
    "timeout_seconds": 120
  },
  "camera": {
    "default_index": 0,
    "capture_dir": "runtime/captures",
    "video_dir": "runtime/video",
    "video_duration_seconds": 5,
    "video_fps": 10,
    "video_frame_dir": "runtime/video_frames",
    "video_sample_count": 5
  },
  "location": {
    "enabled": false,
    "file": "runtime/location.json",
    "max_age_seconds": 300
  }
}
